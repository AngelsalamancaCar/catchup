{{define "content"}}
<h1 style="margin:0">{{if eq .Mode "edit"}}Editar actividad{{else}}Nueva actividad{{end}}</h1>
<p class="hint">Completa los pasos 1 a 6. Los campos marcados son obligatorios.</p>
<div id="wizard" style="margin-top:var(--space-4)">
{{template "step1" .}}
</div>
{{end}}

{{define "hidden_meta"}}
<input type="hidden" name="mode" value="{{.Mode}}">
<input type="hidden" name="activity_id" value="{{.ActivityID}}">
{{end}}

{{define "hidden_A"}}
<input type="hidden" name="name" value="{{.Name}}">
<input type="hidden" name="type" value="{{.Type}}">
<input type="hidden" name="owner" value="{{.Owner}}">
<input type="hidden" name="section" value="{{.Section}}">
{{range .Involved}}<input type="hidden" name="involved" value="{{.}}">{{end}}
<input type="hidden" name="description" value="{{.Description}}">
{{end}}

{{define "hidden_B"}}
<input type="hidden" name="b1" value="{{.B1}}">
<input type="hidden" name="b2" value="{{.B2}}">
<input type="hidden" name="b3" value="{{.B3}}">
<input type="hidden" name="b4" value="{{.B4}}">
{{end}}

{{define "hidden_C"}}
<input type="hidden" name="c1" value="{{.C1}}">
<input type="hidden" name="c2" value="{{.C2}}">
<input type="hidden" name="c3" value="{{.C3}}">
<input type="hidden" name="c4" value="{{.C4}}">
{{end}}

{{define "hidden_D"}}
{{if .NoDeadline}}<input type="hidden" name="no_deadline" value="on">{{end}}
<input type="hidden" name="d1" value="{{.D1}}">
<input type="hidden" name="d2" value="{{.D2}}">
<input type="hidden" name="d3" value="{{.D3}}">
<input type="hidden" name="d4" value="{{.D4}}">
{{end}}

{{define "hidden_E"}}
{{range $d := .Deliverables}}
<input type="hidden" name="deliverables[{{$d.Index}}].name" value="{{$d.Name}}">
<input type="hidden" name="deliverables[{{$d.Index}}].due" value="{{$d.Due}}">
<input type="hidden" name="deliverables[{{$d.Index}}].status" value="{{$d.Status}}">
<input type="hidden" name="deliverables[{{$d.Index}}].depends_on" value="{{$d.DependsOn}}">
{{end}}
{{end}}

{{define "radio5"}}
<div class="field {{if .Error}}has-error{{end}}">
  <label>{{.Label}} *</label>
  <div class="scale">
    {{$name := .Name}}{{$val := .Value}}
    {{range anchors .Name}}
    <label>
      <input type="radio" name="{{$name}}" value="{{.Value}}" {{if eq $val .Value}}checked{{end}} required>
      <span>{{.Value}} — {{.Anchor}}</span>
    </label>
    {{end}}
  </div>
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
</div>
{{end}}

{{define "step1"}}
<div class="steps"><span class="current">1. Identificación</span> · 2. Impacto · 3. Esfuerzo · 4. Urgencia/Importancia · 5. Entregables · 6. Info</div>
<form class="card elev-sm" hx-post="/activities/wizard/step2" hx-target="#wizard" hx-swap="innerHTML">
  {{template "hidden_meta" .}}
  <div class="field {{if .Errors.name}}has-error{{end}}">
    <label>A1. Nombre de la actividad</label>
    <input class="input" type="text" name="name" value="{{.Name}}" autofocus>
    {{if .Errors.name}}<div class="error">{{.Errors.name}}</div>{{end}}
  </div>
  <div class="field {{if .Errors.type}}has-error{{end}}">
    <label>A2. Tipo</label>
    <select class="input" name="type">
      <option value="">-- selecciona --</option>
      <option value="Project" {{if eq .Type "Project"}}selected{{end}}>Proyecto</option>
      <option value="Workstream" {{if eq .Type "Workstream"}}selected{{end}}>Workstream</option>
      <option value="Recurring" {{if eq .Type "Recurring"}}selected{{end}}>Actividad recurrente</option>
      <option value="AdHoc" {{if eq .Type "AdHoc"}}selected{{end}}>Ad-hoc</option>
    </select>
    {{if .Errors.type}}<div class="error">{{.Errors.type}}</div>{{end}}
  </div>
  <div class="field {{if .Errors.owner}}has-error{{end}}">
    <label>A3. Owner (responsable)</label>
    <input class="input" type="text" name="owner" value="{{.Owner}}">
    {{if .Errors.owner}}<div class="error">{{.Errors.owner}}</div>{{end}}
  </div>
  <div class="field {{if .Errors.section}}has-error{{end}}">
    <label>A4. Sección responsable</label>
    <select class="input" name="section">
      <option value="">-- selecciona --</option>
      {{$sec := .Section}}
      {{range .Sections}}<option value="{{.}}" {{if eq $sec .}}selected{{end}}>{{.}}</option>{{end}}
    </select>
    {{if .Errors.section}}<div class="error">{{.Errors.section}}</div>{{end}}
  </div>
  <div class="field">
    <label>A5. Otras secciones involucradas</label>
    <div class="checkbox-grid">
    {{$inv := .Involved}}
    {{range .Sections}}
      <label class="checkbox-row"><input type="checkbox" name="involved" value="{{.}}" {{if contains $inv .}}checked{{end}}> {{.}}</label>
    {{end}}
    </div>
  </div>
  <div class="field">
    <label>A6. Descripción / objetivo</label>
    <textarea class="input" name="description">{{.Description}}</textarea>
  </div>
  <div class="wizard-actions">
    <button type="submit" class="btn btn-primary">Siguiente →</button>
  </div>
</form>
{{end}}

{{define "step2"}}
<div class="steps">1. Identificación · <span class="current">2. Impacto</span> · 3. Esfuerzo · 4. Urgencia/Importancia · 5. Entregables · 6. Info</div>
<form class="card elev-sm" hx-post="/activities/wizard/step3" hx-target="#wizard" hx-swap="innerHTML">
  {{template "hidden_meta" .}}{{template "hidden_A" .}}
  {{template "radio5" dict "Name" "b1" "Label" "B1. Contribución a objetivos estratégicos" "Value" .B1 "Error" .Errors.b1}}
  {{template "radio5" dict "Name" "b2" "Label" "B2. Nº de stakeholders/usuarios afectados" "Value" .B2 "Error" .Errors.b2}}
  {{template "radio5" dict "Name" "b3" "Label" "B3. Efecto financiero o de valor" "Value" .B3 "Error" .Errors.b3}}
  {{template "radio5" dict "Name" "b4" "Label" "B4. Consecuencia de no hacerlo" "Value" .B4 "Error" .Errors.b4}}
  <div class="wizard-actions">
    <button type="submit" class="btn btn-primary">Siguiente →</button>
  </div>
</form>
{{end}}

{{define "step3"}}
<div class="steps">1. Identificación · 2. Impacto · <span class="current">3. Esfuerzo</span> · 4. Urgencia/Importancia · 5. Entregables · 6. Info</div>
<form class="card elev-sm" hx-post="/activities/wizard/step4" hx-target="#wizard" hx-swap="innerHTML">
  {{template "hidden_meta" .}}{{template "hidden_A" .}}{{template "hidden_B" .}}
  <div class="field {{if .Errors.c1}}has-error{{end}}">
    <label>C1. Esfuerzo estimado (persona-días)</label>
    <select class="input" name="c1">
      <option value="">-- selecciona --</option>
      <option value="<5" {{if eq .C1 "<5"}}selected{{end}}>Menos de 5</option>
      <option value="5-20" {{if eq .C1 "5-20"}}selected{{end}}>5 a 20</option>
      <option value="20-60" {{if eq .C1 "20-60"}}selected{{end}}>20 a 60</option>
      <option value="60-120" {{if eq .C1 "60-120"}}selected{{end}}>60 a 120</option>
      <option value=">120" {{if eq .C1 ">120"}}selected{{end}}>Más de 120</option>
    </select>
    {{if .Errors.c1}}<div class="error">{{.Errors.c1}}</div>{{end}}
  </div>
  {{template "radio5" dict "Name" "c2" "Label" "C2. Nº de secciones/equipos que deben coordinar" "Value" .C2 "Error" .Errors.c2}}
  {{template "radio5" dict "Name" "c3" "Label" "C3. Complejidad técnica o procedural" "Value" .C3 "Error" .Errors.c3}}
  <div class="field {{if .Errors.c4}}has-error{{end}}">
    <label>C4. Dependencias externas</label>
    <select class="input" name="c4">
      <option value="">-- selecciona --</option>
      <option value="none" {{if eq .C4 "none"}}selected{{end}}>Ninguna</option>
      <option value="some" {{if eq .C4 "some"}}selected{{end}}>Algunas</option>
      <option value="blocking" {{if eq .C4 "blocking"}}selected{{end}}>Bloqueantes</option>
    </select>
    {{if .Errors.c4}}<div class="error">{{.Errors.c4}}</div>{{end}}
  </div>
  <div class="wizard-actions">
    <button type="submit" class="btn btn-primary">Siguiente →</button>
  </div>
</form>
{{end}}

{{define "step4"}}
<div class="steps">1. Identificación · 2. Impacto · 3. Esfuerzo · <span class="current">4. Urgencia/Importancia</span> · 5. Entregables · 6. Info</div>
<form class="card elev-sm" hx-post="/activities/wizard/step5" hx-target="#wizard" hx-swap="innerHTML">
  {{template "hidden_meta" .}}{{template "hidden_A" .}}{{template "hidden_B" .}}{{template "hidden_C" .}}
  <div class="field {{if .Errors.d1}}has-error{{end}}">
    <label>D1. Fecha límite (deadline)</label>
    <input class="input" type="date" name="d1" value="{{.D1}}" {{if .NoDeadline}}disabled{{end}}>
    <label class="checkbox-row" style="margin-top:6px">
      <input type="checkbox" name="no_deadline" value="on" {{if .NoDeadline}}checked{{end}}
        onchange="this.form.d1.disabled = this.checked; if(this.checked) this.form.d1.value='';">
      Sin deadline
    </label>
    {{if .Errors.d1}}<div class="error">{{.Errors.d1}}</div>{{end}}
  </div>
  <div class="field {{if .Errors.d2}}has-error{{end}}">
    <label>D2. ¿Qué pasa si se retrasa 30 días?</label>
    <select class="input" name="d2">
      <option value="">-- selecciona --</option>
      <option value="nothing" {{if eq .D2 "nothing"}}selected{{end}}>Nada</option>
      <option value="friction" {{if eq .D2 "friction"}}selected{{end}}>Fricción menor</option>
      <option value="escalation" {{if eq .D2 "escalation"}}selected{{end}}>Escalamiento</option>
      <option value="breach" {{if eq .D2 "breach"}}selected{{end}}>Incumplimiento o pérdida</option>
    </select>
    {{if .Errors.d2}}<div class="error">{{.Errors.d2}}</div>{{end}}
  </div>
  <div class="field {{if .Errors.d3}}has-error{{end}}">
    <label>D3. ¿Es importante para tus objetivos o para los de otra persona?</label>
    <select class="input" name="d3">
      <option value="">-- selecciona --</option>
      <option value="mine" {{if eq .D3 "mine"}}selected{{end}}>Míos</option>
      <option value="shared" {{if eq .D3 "shared"}}selected{{end}}>Compartidos</option>
      <option value="other" {{if eq .D3 "other"}}selected{{end}}>De otra persona/área</option>
    </select>
    {{if .Errors.d3}}<div class="error">{{.Errors.d3}}</div>{{end}}
  </div>
  <div class="field {{if .Errors.d4}}has-error{{end}}">
    <label>D4. ¿Un colega competente podría hacerlo con un briefing corto?</label>
    <select class="input" name="d4">
      <option value="">-- selecciona --</option>
      <option value="yes" {{if eq .D4 "yes"}}selected{{end}}>Sí</option>
      <option value="partial" {{if eq .D4 "partial"}}selected{{end}}>Parcialmente</option>
      <option value="no" {{if eq .D4 "no"}}selected{{end}}>No</option>
    </select>
    {{if .Errors.d4}}<div class="error">{{.Errors.d4}}</div>{{end}}
  </div>
  <div class="wizard-actions">
    <button type="submit" class="btn btn-primary">Siguiente →</button>
  </div>
</form>
{{end}}

{{define "deliverable_row"}}
<div class="deliverable-row">
  <div class="field">
    <label>Nombre</label>
    <input class="input" type="text" name="deliverables[{{.Index}}].name" value="{{.Name}}">
  </div>
  <div class="field">
    <label>Fecha</label>
    <input class="input" type="date" name="deliverables[{{.Index}}].due" value="{{.Due}}">
  </div>
  <div class="field">
    <label>Estado</label>
    <select class="input" name="deliverables[{{.Index}}].status">
      <option value="not_started" {{if eq .Status "not_started"}}selected{{end}}>No iniciado</option>
      <option value="in_progress" {{if eq .Status "in_progress"}}selected{{end}}>En progreso</option>
      <option value="at_risk" {{if eq .Status "at_risk"}}selected{{end}}>En riesgo</option>
      <option value="done" {{if eq .Status "done"}}selected{{end}}>Hecho</option>
    </select>
  </div>
  <div class="field">
    <label>Depende de (ID)</label>
    <input class="input" type="text" name="deliverables[{{.Index}}].depends_on" value="{{.DependsOn}}" placeholder="opcional">
  </div>
</div>
{{end}}

{{define "deliverable_add_button"}}
<button type="button" id="add-deliverable-btn" hx-swap-oob="true" class="btn btn-secondary btn-small"
  hx-get="/activities/wizard/deliverable-row?index={{.NextIndex}}"
  hx-target="#deliverable-rows" hx-swap="beforeend">+ Deliverable</button>
{{end}}

{{define "step5"}}
<div class="steps">1. Identificación · 2. Impacto · 3. Esfuerzo · 4. Urgencia/Importancia · <span class="current">5. Entregables</span> · 6. Info</div>
<form class="card elev-sm" hx-post="/activities/wizard/step6" hx-target="#wizard" hx-swap="innerHTML">
  {{template "hidden_meta" .}}{{template "hidden_A" .}}{{template "hidden_B" .}}{{template "hidden_C" .}}{{template "hidden_D" .}}
  <p class="hint">Sección E — opcional: añade tantos entregables como necesites.</p>
  {{range .Errors}}<div class="error">{{.}}</div>{{end}}
  <div id="deliverable-rows">
    {{range .Deliverables}}{{template "deliverable_row" .}}{{end}}
  </div>
  <button type="button" id="add-deliverable-btn" class="btn btn-secondary btn-small"
    hx-get="/activities/wizard/deliverable-row?index={{len .Deliverables}}"
    hx-target="#deliverable-rows" hx-swap="beforeend">+ Deliverable</button>
  <div class="wizard-actions">
    <button type="submit" class="btn btn-primary">Siguiente →</button>
  </div>
</form>
{{end}}

{{define "step6"}}
<div class="steps">1. Identificación · 2. Impacto · 3. Esfuerzo · 4. Urgencia/Importancia · 5. Entregables · <span class="current">6. Info</span></div>
<form class="card elev-sm" {{if eq .Mode "edit"}}hx-put="/activities/{{.ActivityID}}"{{else}}hx-post="/activities"{{end}} hx-target="#wizard" hx-swap="innerHTML">
  {{template "hidden_meta" .}}{{template "hidden_A" .}}{{template "hidden_B" .}}{{template "hidden_C" .}}{{template "hidden_D" .}}{{template "hidden_E" .}}
  {{template "radio5" dict "Name" "f1" "Label" "F1. Confianza en las estimaciones anteriores" "Value" .F1 "Error" .Errors.f1}}
  <div class="field">
    <label>F2. ¿Qué respuestas fueron conjeturas?</label>
    <div class="checkbox-grid">
      {{$f2 := .F2}}
      {{range $k := (slice "B1" "B2" "B3" "B4" "C1" "C2" "C3" "C4" "D1" "D2" "D3" "D4")}}
      <label class="checkbox-row"><input type="checkbox" name="f2" value="{{$k}}" {{if contains $f2 $k}}checked{{end}}> {{$k}}</label>
      {{end}}
    </div>
  </div>
  <div class="field">
    <label>F3. ¿Qué información falta y quién la tiene?</label>
    <textarea class="input" name="f3">{{.F3}}</textarea>
  </div>
  <div class="wizard-actions">
    <button type="submit" class="btn btn-primary">{{if eq .Mode "edit"}}Guardar cambios{{else}}Guardar actividad{{end}}</button>
  </div>
</form>
{{end}}

{{define "wizard_error"}}
<div class="card elev-sm">
  <p class="error">{{.Message}}</p>
  <a class="btn btn-primary" href="/activities/new">Volver a empezar</a>
</div>
{{end}}
