{{define "content"}}
<h1 style="margin:0">Matriz Impacto/Esfuerzo</h1>
<p class="hint">{{.Count}} de {{.TotalCount}} actividades mostradas.</p>

<div class="card elev-sm" style="margin-top:var(--space-4)">
  <form hx-get="/matrix/impact-effort/svg" hx-target="#matrix-container" hx-swap="innerHTML" hx-trigger="change">
    <div class="threshold-controls">
      <div class="field">
        <label>Umbral de Impacto: <span id="impact-th-val">{{pct .ImpactThreshold}}</span></label>
        <input type="range" min="0" max="100" name="impact_threshold" value="{{.ImpactThreshold}}"
          oninput="document.getElementById('impact-th-val').textContent = this.value">
      </div>
      <div class="field">
        <label>Umbral de Esfuerzo: <span id="effort-th-val">{{pct .EffortThreshold}}</span></label>
        <input type="range" min="0" max="100" name="effort_threshold" value="{{.EffortThreshold}}"
          oninput="document.getElementById('effort-th-val').textContent = this.value">
      </div>
    </div>
    <div class="toolbar-toggles">
      <label class="checkbox-row"><input type="radio" name="color_mode" value="section" {{if eq .ColorMode "section"}}checked{{end}}> Color por sección</label>
      <label class="checkbox-row"><input type="radio" name="color_mode" value="fit" {{if eq .ColorMode "fit"}}checked{{end}}> Color por fit estratégico (B1)</label>
      <label class="checkbox-row"><input type="checkbox" name="show_all" value="1" {{if .ShowAll}}checked{{end}}> Mostrar todos los tipos (no solo Proyectos/Workstreams)</label>
    </div>
  </form>
</div>

<div class="matrix-layout" style="margin-top:var(--space-4)">
  <div id="matrix-container">
  {{template "matrix_container" .}}
  </div>
  <div id="detail-panel" class="card elev-sm detail-panel">
    <p class="card-body">Haz click en un punto de la matriz para ver su desglose.</p>
  </div>
</div>
{{end}}

{{define "matrix_container"}}
<div class="card elev-sm">
  {{template "matrix_svg" .SVG}}
  <div class="legend">
  {{if eq .ColorMode "section"}}
    {{$sections := .Sections}}
    {{range .Sections}}<span class="legend-item"><span class="legend-dot" style="background:{{sectionColor $sections .}}"></span>{{.}}</span>{{end}}
  {{else}}
    <span class="legend-item">Fit estratégico (B1):</span>
    {{range fitLegend}}<span class="legend-item"><span class="legend-dot" style="background:{{.Color}}"></span>{{.Value}}</span>{{end}}
  {{end}}
  </div>
</div>
{{end}}
