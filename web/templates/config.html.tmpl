{{define "content"}}
<h1>Configuración</h1>

<div class="card">
  <h2 style="margin-top:0;">Secciones organizacionales</h2>
  <p class="hint">Una por línea. Se usan en A4/A5 del cuestionario y en el mapa organizacional.</p>
  <form method="post" action="/config/sections">
    <div class="field {{if .SectionsErr}}has-error{{end}}">
      <textarea name="sections" rows="6">{{range .Sections}}{{.}}
{{end}}</textarea>
      {{if .SectionsErr}}<div class="error">{{.SectionsErr}}</div>{{end}}
    </div>
    <button type="submit" class="btn">Guardar secciones</button>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0;">Pesos de scoring</h2>
  <p class="hint">Cada dimensión (Impacto, Esfuerzo) debe sumar 1.0 entre sus 4 componentes.</p>
  <form method="post" action="/config/weights">
    <h3>Impacto (B1–B4)</h3>
    <div class="weights-grid">
      <div class="field"><label>B1</label><input type="number" step="0.01" min="0" max="1" name="b1" value="{{index .Weights.Impact "B1"}}"></div>
      <div class="field"><label>B2</label><input type="number" step="0.01" min="0" max="1" name="b2" value="{{index .Weights.Impact "B2"}}"></div>
      <div class="field"><label>B3</label><input type="number" step="0.01" min="0" max="1" name="b3" value="{{index .Weights.Impact "B3"}}"></div>
      <div class="field"><label>B4</label><input type="number" step="0.01" min="0" max="1" name="b4" value="{{index .Weights.Impact "B4"}}"></div>
    </div>
    <h3>Esfuerzo (C1–C4)</h3>
    <div class="weights-grid">
      <div class="field"><label>C1</label><input type="number" step="0.01" min="0" max="1" name="c1" value="{{index .Weights.Effort "C1"}}"></div>
      <div class="field"><label>C2</label><input type="number" step="0.01" min="0" max="1" name="c2" value="{{index .Weights.Effort "C2"}}"></div>
      <div class="field"><label>C3</label><input type="number" step="0.01" min="0" max="1" name="c3" value="{{index .Weights.Effort "C3"}}"></div>
      <div class="field"><label>C4</label><input type="number" step="0.01" min="0" max="1" name="c4" value="{{index .Weights.Effort "C4"}}"></div>
    </div>
    {{if .WeightsErr}}<div class="error">{{.WeightsErr}}</div>{{end}}
    <button type="submit" class="btn" style="margin-top:0.75rem;">Guardar pesos</button>
  </form>
</div>
{{end}}
