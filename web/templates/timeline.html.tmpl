{{define "content"}}
<div class="card">
  <h1>Timeline de entregables</h1>
  <p class="hint">{{.Count}} de {{.TotalCount}} entregables mostrados.</p>
</div>

<div class="card">
  <form hx-get="/timeline/svg" hx-target="#timeline-container" hx-swap="innerHTML" hx-trigger="change" hx-push-url="true">
    {{$filterSections := .Filters.Sections}}
    {{$filterQuadrants := .Filters.Quadrants}}
    <div class="field">
      <label>Secciones</label>
      <div class="checkbox-grid">
        {{range .Sections}}
        <label class="checkbox-row"><input type="checkbox" name="section" value="{{.}}" {{if contains $filterSections .}}checked{{end}}> {{.}}</label>
        {{end}}
      </div>
    </div>
    <div class="field">
      <label>Cuadrante (Impacto/Esfuerzo o Eisenhower)</label>
      <div class="checkbox-grid">
        {{range .QuadrantOptions}}
        <label class="checkbox-row"><input type="checkbox" name="quadrant" value="{{.Value}}" {{if contains $filterQuadrants .Value}}checked{{end}}> {{.Label}}</label>
        {{end}}
      </div>
    </div>
    <div class="threshold-controls">
      <div class="field">
        <label>Desde</label>
        <input type="date" name="from" value="{{.Filters.From}}">
      </div>
      <div class="field">
        <label>Hasta</label>
        <input type="date" name="to" value="{{.Filters.To}}">
      </div>
    </div>
  </form>
</div>

<div class="matrix-layout">
  <div id="timeline-container">
  {{template "timeline_container" .}}
  </div>
  <div id="detail-panel" class="card detail-panel">
    <p class="hint">Haz click en un entregable para ver el desglose de scores de su actividad.</p>
  </div>
</div>
{{end}}

{{define "timeline_container"}}
<div class="card">
  {{template "timeline_svg" .SVG}}
  <div class="legend">
    <span class="legend-item"><span class="legend-dot status-not_started"></span>No iniciado</span>
    <span class="legend-item"><span class="legend-dot status-in_progress"></span>En progreso</span>
    <span class="legend-item"><span class="legend-dot status-at_risk"></span>En riesgo (marcado por owner)</span>
    <span class="legend-item"><span class="legend-dot status-done"></span>Completado</span>
    <span class="legend-item"><span class="legend-dot tl-marker-risk"></span>At-risk (auto: vence en &lt;14 días o dependencia en riesgo)</span>
  </div>
</div>
{{end}}
