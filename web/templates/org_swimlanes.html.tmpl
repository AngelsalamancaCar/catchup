{{define "content"}}
<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4)">
  <div>
    <h1 style="margin:0">Organización</h1>
    <p class="hint">Swimlanes por sección, con conectores de involucramiento cruzado (A5).</p>
  </div>
  <div class="seg">
    <a aria-current="true" href="/org/swimlanes">Swimlanes</a>
    <a href="/org/treemap">Treemap</a>
  </div>
</div>
{{if .FilterSection}}
<p class="hint">Filtrando por sección: <strong>{{.FilterSection}}</strong> — <a href="/org/swimlanes">quitar filtro</a></p>
{{end}}

<div class="matrix-layout" style="margin-top:var(--space-4)">
  <div class="card elev-sm">
    {{template "swimlane_svg" .SVG}}
  </div>
  <div id="detail-panel" class="card elev-sm detail-panel">
    <p class="card-body">Haz click en una tarjeta para ver su desglose de scores.</p>
  </div>
</div>
{{end}}
