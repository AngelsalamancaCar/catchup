{{define "layout"}}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — Project Mapper</title>
<link rel="stylesheet" href="/static/app.css">
<script src="/static/htmx.min.js"></script>
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/></svg>
      </div>
      <div>
        <div class="sidebar-brand-name">Project Mapper</div>
        <div class="sidebar-brand-sub">Portafolio priorizado</div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a class="nav-item {{if eq .Nav "home"}}active{{end}}" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v9h12v-9"/></svg>
        <span>Inicio</span>
      </a>
      <a class="nav-item {{if eq .Nav "activities"}}active{{end}}" href="/activities">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h11M8 12h11M8 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg>
        <span>Actividades</span>
      </a>
      <a class="nav-item {{if eq .Nav "impact-effort"}}active{{end}}" href="/matrix/impact-effort">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V4M4 20h16"/><circle cx="10" cy="8" r="1.6" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="8" cy="15" r="1.6" fill="currentColor" stroke="none"/></svg>
        <span>Matriz I/E</span>
      </a>
      <a class="nav-item {{if eq .Nav "eisenhower"}}active{{end}}" href="/matrix/eisenhower">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M12 4v16M4 12h16"/></svg>
        <span>Eisenhower</span>
      </a>
      <a class="nav-item {{if eq .Nav "org"}}active{{end}}" href="/org/swimlanes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="19" r="2.2"/><path d="M12 7.2v4M12 11.2 6 16.8M12 11.2l6 5.6"/></svg>
        <span>Organización</span>
      </a>
      <a class="nav-item {{if eq .Nav "timeline"}}active{{end}}" href="/timeline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h7M4 12h11M4 18h5"/><circle cx="15" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="13" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>
        <span>Timeline</span>
      </a>
      <a class="nav-item {{if eq .Nav "config"}}active{{end}}" href="/config">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6M18.4 18.4l-1.6-1.6M7.2 7.2 5.6 5.6"/></svg>
        <span>Configuración</span>
      </a>
      <a class="nav-item {{if eq .Nav "help"}}active{{end}}" href="/help">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.2a2.5 2.5 0 1 1 3.4 2.3c-.9.4-1.4 1-1.4 2"/><circle cx="12" cy="16.6" r="0.9" fill="currentColor" stroke="none"/></svg>
        <span>Ayuda</span>
      </a>
    </nav>
    <div class="sidebar-footnote">Local-only. Los datos no salen de esta máquina.</div>
  </aside>

  <main class="main">
    <div class="content">
{{template "content" .}}
    </div>
  </main>
</div>
</body>
</html>
{{end}}
