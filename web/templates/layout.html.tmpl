{{define "layout"}}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — Project Mapper</title>
<link rel="stylesheet" href="/static/app.css">
<script src="/static/htmx.min.js"></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Project Mapper</a>
  <nav>
    <a href="/activities" {{if eq .Nav "activities"}}class="active"{{end}}>Actividades</a>
    <a href="/matrix/impact-effort" {{if eq .Nav "impact-effort"}}class="active"{{end}}>Matriz I/E</a>
    <a href="/matrix/eisenhower" {{if eq .Nav "eisenhower"}}class="active"{{end}}>Eisenhower</a>
    <a href="/org/swimlanes" {{if eq .Nav "org"}}class="active"{{end}}>Organización</a>
    <a href="/timeline" {{if eq .Nav "timeline"}}class="active"{{end}}>Timeline</a>
    <a href="/config" {{if eq .Nav "config"}}class="active"{{end}}>Configuración</a>
  </nav>
</header>
<main class="content">
{{template "content" .}}
</main>
</body>
</html>
{{end}}
