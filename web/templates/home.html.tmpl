{{define "content"}}
<h1 style="margin:0">Project Mapper</h1>
<p class="hint" style="max-width:640px">Resumen rápido del portafolio: clasificación por impacto, esfuerzo y coordinación organizacional, calculada en vivo a partir del cuestionario.</p>
<div class="dashboard-grid" style="margin-top:var(--space-6)">
  {{range .Cards}}
  <a class="card elev-sm dashboard-card" href="{{.Link}}">
    <div class="card-title">{{.Title}}</div>
    {{range .Lines}}<p class="card-body">{{.}}</p>{{end}}
    <div class="card-meta">Ver detalle →</div>
  </a>
  {{end}}
</div>
{{end}}
